+    // Local change: GT5U 5.09.54.133 dev jars reference jvmdowngrader stubs, which a transformer fails on in
+    // LaunchClassLoader; load them untransformed from the app class path (they are on it).
+    static {
+        try {
+            ClassLoader cl = DumperMod.class.getClassLoader();
+            cl.getClass().getMethod("addClassLoaderExclusion", String.class).invoke(cl, "xyz.wagyourtail.jvmdg.");
+        } catch (Throwable t) {
+            LogManager.getLogger(MODID).warn("gtnh-extractor: could not exclude jvmdg stubs", t);
+        }
+    }
+
     /**
      * The sided half of this mod, which exists solely for the client auto-world harness.
      *
