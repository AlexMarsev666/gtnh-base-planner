diff --git a/tools/gtnh-extractor/build.gradle.kts b/tools/gtnh-extractor/build.gradle.kts
index 53adbc7..c339bf0 100644
--- a/tools/gtnh-extractor/build.gradle.kts
+++ b/tools/gtnh-extractor/build.gradle.kts
@@ -25,6 +25,8 @@ plugins {
 // The RFG run tasks are JavaExec-based; guard the cast so a future task-type change fails clearly.
 tasks.matching { it.name.startsWith("runServer") || it.name.startsWith("runClient") }.configureEach {
     if (this is JavaExec) {
+        // Local change: headless, so a dev-time folder picker (CoFHCore's MCP remapper) fails instead of hanging.
+        if (name.startsWith("runServer")) systemProperty("java.awt.headless", "true")
         (project.findProperty("datasetOut") as String?)?.let {
             systemProperty("gtnhextractor.datasetOut", project.file(it).absolutePath)
         }
diff --git a/tools/gtnh-extractor/dependencies.gradle b/tools/gtnh-extractor/dependencies.gradle
index 13bead4..e8e3b0d 100644
--- a/tools/gtnh-extractor/dependencies.gradle
+++ b/tools/gtnh-extractor/dependencies.gradle
@@ -40,13 +40,13 @@ dependencies {
     // :compileJava. Thaumcraft integration is not needed to enumerate or construct
     // multiblocks, so drop that one broken optional subtree; every other GT5U hard
     // dependency still resolves and loads on the dev server.
-    implementation("com.github.GTNewHorizons:GT5-Unofficial:5.09.54.20:dev") {
+    implementation("com.github.GTNewHorizons:GT5-Unofficial:5.09.54.205:dev") {
         exclude group: "com.github.GTNewHorizons", module: "ThaumicTinkerer"
     }
 
     // StructureLib - the multiblock structure framework (LGPL, GTNewHorizons).
     // Pinned from DreamAssemblerXXL manifest 2.9.0-beta-2; matches GT5U's transitive requirement.
-    implementation("com.github.GTNewHorizons:StructureLib:1.4.42:dev")
+    implementation("com.github.GTNewHorizons:StructureLib:1.4.45:dev")
 
     // JUnit 4, for the ASM icon-name matcher only (#98). Deliberately a SEPARATE suite from the
     // project's pytest gate: run it with `./gradlew test` from this directory. It is not wired
@@ -60,3 +60,20 @@ dependencies {
     // net.minecraft:launchwrapper, which is exactly why this route costs no new dependency.
     testImplementation("junit:junit:4.13.2")
 }
+
+// Local change (wallshare planner dump): Windows Defender quarantines GTNHExtLib-1.0.4.jar on download.
+// In the pack, GTNHLib fetches the same three libraries at run time instead, so use them directly.
+configurations.all {
+    exclude group: "com.github.GTNewHorizons", module: "GTNHExtLib"
+}
+dependencies {
+    implementation("it.unimi.dsi:fastutil:8.5.18")
+    implementation("org.joml:joml:1.10.8")
+    implementation("com.mojang:brigadier:1.0.18")
+}
+
+// Local change: GT5U 5.09.54.133 references jvmdowngrader stubs; GTNHLib mirrors them onto the system class
+// loader only, which LaunchClassLoader never asks, so put them on the run classpath too.
+dependencies {
+    runtimeOnly("xyz.wagyourtail.jvmdowngrader:jvmdowngrader-java-api:2.0.1:downgraded-8")
+}
